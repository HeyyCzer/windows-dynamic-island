// English — the reference locale. Every other file in this folder should have
// the same keys; anything missing falls back to the text here.
//
// - The file name is the language's BCP 47 code (`pt-BR.json5`, `es.json5`…).
// - Nested objects become dotted keys: `settings.general` → t("settings.general").
// - `{name}` placeholders are filled in by the code; keep them as is.
{
  language: {
    // Shown in the language picker, written in the language itself.
    name: "English",
  },

  // Settings window
  settings: {
    subtitle: "Settings",
    // Sidebar groups
    section: {
      app: "App",
      island: "Island",
    },
    general: "General",
    minimize: "Minimize",
    close: "Close",
    module: {
      label: "Show in the island",
      desc: "Turn off to hide this module completely.",
    },
    autostart: {
      label: "Start with Windows",
      appOnly: "Only available in the app.",
    },
    language: {
      label: "Language",
      desc: "Defaults to your system language.",
      // {language}: the detected system language's name
      auto: "System ({language})",
    },
    hideInFullscreen: {
      label: "Hide in fullscreen",
      desc: "Hides the island while a game, video or app is fullscreen.",
    },
    expandOnHover: {
      label: "Expand on hover",
      desc: "When off, the island only expands on click.",
    },
    monitor: {
      label: "Monitor",
      desc: "Where the island lives. Automatic follows the primary monitor set in Windows.",
      // {name}: the primary monitor's name
      auto: "Automatic ({name})",
      // {n}: the monitor's number, for monitors without a model name
      generic: "Monitor {n}",
      primary: "primary",
      missing: "Disconnected monitor (using the primary)",
    },
    avoidMaximized: {
      label: "Avoid fullscreen apps",
      desc: "Moves the island to another monitor while a fullscreen app (game, video, presentation) would hide it.",
    },
    returnToCenter: {
      label: "Return to center",
      desc: "Drag the island left or right along the top. When off, it stays where you drop it.",
    },
    returnDelay: {
      label: "Return after",
      desc: "Seconds before a dragged island slides back to the middle.",
    },
    about: {
      title: "About",
      // {version}: the app version, e.g. 1.2.3
      version: "Version {version}",
      source: "Source code",
      license: "License",
      updates: {
        label: "Updates",
        idle: "Check whether a new version is out.",
        checking: "Checking…",
        latest: "You're on the latest version.",
        // {version}: the new version, e.g. 1.2.3
        ready: "Version {version} is ready to install.",
        dev: "Development builds don't update.",
        error: "Couldn't check for updates.",
        check: "Check",
        install: "Restart and update",
      },
    },
  },

  // Rendered by the backend (src-tauri/src/i18n.rs)
  tray: {
    // {version}: the new version, e.g. 1.2.3
    update: "Restart to update to v{version}",
    settings: "Settings…",
    autostart: "Start with Windows",
    recenter: "Recenter",
    quit: "Quit",
    hide: "Hide island",
    show: "Show island",
    hiddenTooltip: "Dynamic Island (hidden): click to show",
  },
  window: {
    settings: "Dynamic Island — Settings",
  },

  // Island chrome
  island: {
    settings: "Settings",
  },

  // Modules page of the settings: every module, its tab order and on/off
  modules: {
    title: "Modules",
    desc: "Drag to reorder the tabs. Modules in the tab bar are always one click away; the others are in the launcher (the grid button), and a busy one shows up in the bar anyway. Click a module for its settings.",
    open: "Open settings",
  },

  // Tabs of the open island: tab bar and launcher
  layout: {
    launcher: "All modules",
    pinned: "In the tab bar",
    drag: "Drag to reorder",
    inBar: "Tab bar",
    inLauncher: "Launcher",
    pin: "Show in the tab bar",
    unpin: "Move to the launcher",
  },

  // Music module
  music: {
    title: "Music",
    nothingPlaying: "Nothing playing",
    autoExpand: {
      label: "Expand on track change",
      desc: "Shows the artwork and title for a few seconds when a new track starts.",
    },
    visualizer: {
      label: "Audio visualizer",
      desc: "Animated bars that follow the music.",
    },
    // YouTube video mirrored in the island / pinned to its own window
    pin: "Pin",
    pinned: "Video pinned · bring back",
    unpin: "Bring the video back to the island",
    backToIsland: "Back to the island",
  },

  // AI Agents module (agent-agnostic UI)
  agents: {
    title: "AI Agents",
    peekOnWaiting: {
      label: "Expand when an agent needs your attention",
      desc: "A permission request or a question waiting for your answer.",
    },
    peekOnDone: {
      label: "Expand when an agent finishes",
    },
	peekOnLimitsReset: {
      label: "Expand when the limit resets",
      desc: "When the request limit of the plan resets and can be used again.",
    },
    status: {
      working: "Working",
      waiting: "Waiting for you",
      done: "Done",
	  limitsReset: "Limits reset, you can use it again!"
    },
    now: "Now",
    openProject: "Open in VS Code",
    // 7-day usage from the local transcripts
    usage: {
      today: "Today",
      todayShort: "today",
      week: "7 days",
      last5h: "Last 5h",
      // {n}: count
      response: "{n} response",
      responses: "{n} responses",
    },
    noSessions: "No recent sessions",
    contextUsed: "Context used",
    noLimits: "No limit data yet",
    tokensToday: "Tokens today",
    tokens: {
      input: "Input",
      output: "Output",
      cacheRead: "Cache read",
      cacheWrite: "Cache write",
    },
    limit: {
      fiveHour: "Session · 5h",
      sevenDay: "Week · 7d",
      // {time}: e.g. "2h 14m"
      resetsIn: "resets in {time}",
    },
    setup: {
      busy: "Enabling…",
      failed: "Failed — try again",
    },
  },

  // GitHub module
  github: {
    title: "GitHub",
    openIssues: "Open issues",
    refresh: "Refresh",
    loading: "Updating…",
    // {time}: relative time, e.g. "5 min ago"
    updated: "Updated {time}",
    // {time}: clock time, e.g. 14:05
    rateLimited: "Rate limited until {time}",
    empty: "No repositories yet",
    addInSettings: "Add one in settings",
    newIssue: "New",
    noIssues: "No open issues",
    showBubble: {
      label: "Side bubble",
      desc: "Shows the total of open issues next to the island.",
    },
    peekOnNew: {
      label: "Expand on new issue",
      desc: "Opens the island for a few seconds when someone opens an issue.",
    },
    error: {
      notFound: "Not found or no access",
      unauthorized: "Token rejected by GitHub",
      rateLimited: "Rate limited",
      network: "Offline",
      http: "GitHub error",
