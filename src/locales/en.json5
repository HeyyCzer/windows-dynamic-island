      desc: "Moves the island to another monitor while a fullscreen app (game, video, presentation) would hide it.",
    },
    returnToCenter: {
      label: "Return to center",
      desc: "Drag the island left or right along the top. When off, it stays where you drop it.",
    },
    returnDelay: {
      label: "Return after",
      desc: "Seconds before a dragged island slides back to the middle.",
    },
    topMargin: {
      label: "Top vertical offset (avoid top taskbar)",
      desc: "Additional vertical distance from the top screen edge. Set to 48 px if your Windows taskbar is placed at the top.",
    },
    about: {
      title: "About",
      // {version}: the app version, e.g. 1.2.3
      version: "Version {version}",
      source: "Source code",
      license: "License",
      updates: {
        label: "Updates",
