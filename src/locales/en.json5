// English — the reference locale. Every other file in this folder should have
// the same keys; anything missing falls back to the text here.
//
// - The file name is the language's BCP 47 code (`pt-BR.json5`, `es.json5`…).
// - Nested objects become dotted keys: `settings.general` → t("settings.general").
// - `{name}` placeholders are filled in by the code; keep them as is.
{
  language: {
    // Shown in the language picker, written in the language itself.
    name: "English",
  },

  // Settings window
  settings: {
    subtitle: "Settings",
    // Sidebar groups
    section: {
      app: "App",
      island: "Island",
    },
    general: "General",
    minimize: "Minimize",
    close: "Close",
    module: {
      label: "Show in the island",
      desc: "Turn off to hide this module completely.",
    },
