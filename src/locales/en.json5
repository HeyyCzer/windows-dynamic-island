// English — the reference locale. Every other file in this folder should have
// the same keys; anything missing falls back to the text here.
//
// - The file name is the language's BCP 47 code (`pt-BR.json5`, `es.json5`…).
// - Nested objects become dotted keys: `settings.general` → t("settings.general").
// - `{name}` placeholders are filled in by the code; keep them as is.
{
  language: {
    // Shown in the language picker, written in the language itself.
    name: "English",
  },

  // Settings window
  settings: {
    subtitle: "Settings",
    general: "General",
    minimize: "Minimize",
    close: "Close",
    module: {
      label: "Show in the island",
      desc: "Turn off to hide this module completely.",
    },
    autostart: {
      label: "Start with Windows",
      appOnly: "Only available in the app.",
    },
    language: {
      label: "Language",
      desc: "Defaults to your system language.",
      // {language}: the detected system language's name
      auto: "System ({language})",
    },
    hideInFullscreen: {
      label: "Hide in fullscreen",
      desc: "Hides the island while a game, video or app is fullscreen.",
    },
    expandOnHover: {
      label: "Expand on hover",
      desc: "When off, the island only expands on click.",
    },
    returnToCenter: {
      label: "Return to center",
      desc: "Drag the island left or right along the top. When off, it stays where you drop it.",
    },
    returnDelay: {
      label: "Return after",
      desc: "Seconds before a dragged island slides back to the middle.",
    },
    about: {
      title: "About",
      // {version}: the app version, e.g. 1.2.3
      version: "Version {version}",
      source: "Source code",
      license: "License",
      updates: {
        label: "Updates",
        idle: "Check whether a new version is out.",
        checking: "Checking…",
        latest: "You're on the latest version.",
        // {version}: the new version, e.g. 1.2.3
        ready: "Version {version} is ready to install.",
        dev: "Development builds don't update.",
        error: "Couldn't check for updates.",
        check: "Check",
        install: "Restart and update",
      },
    },
  },

  // Rendered by the backend (src-tauri/src/i18n.rs)
  tray: {
    // {version}: the new version, e.g. 1.2.3
    update: "Restart to update to v{version}",
    settings: "Settings…",
    autostart: "Start with Windows",
    recenter: "Recenter",
    quit: "Quit",
  },
  window: {
    settings: "Dynamic Island — Settings",
  },

  // Island chrome
  island: {
    settings: "Settings",
  },

  // Music module
  music: {
    title: "Music",
    nothingPlaying: "Nothing playing",
    autoExpand: {
      label: "Expand on track change",
      desc: "Shows the artwork and title for a few seconds when a new track starts.",
    },
    visualizer: {
      label: "Audio visualizer",
      desc: "Animated bars that follow the music.",
    },
  },

  // AI Agents module (agent-agnostic UI)
  agents: {
    title: "AI Agents",
    peekOnWaiting: {
      label: "Expand when an agent needs your attention",
      desc: "A permission request or a question waiting for your answer.",
    },
    peekOnDone: {
      label: "Expand when an agent finishes",
    },
	peekOnLimitsReset: {
      label: "Expand when the limit resets",
      desc: "When the request limit of the plan resets and can be used again.",
    },
    status: {
      working: "Working",
      waiting: "Waiting for you",
      done: "Done",
	  limitsReset: "Limits reset, you can use it again!"
    },
    now: "Now",
    noSessions: "No recent sessions",
    contextUsed: "Context used",
    noLimits: "No limit data yet",
    tokensToday: "Tokens today",
    tokens: {
      input: "Input",
      output: "Output",
      cacheRead: "Cache read",
      cacheWrite: "Cache write",
    },
    limit: {
      fiveHour: "Session · 5h",
      sevenDay: "Week · 7d",
      // {time}: e.g. "2h 14m"
      resetsIn: "resets in {time}",
    },
    setup: {
      busy: "Enabling…",
      failed: "Failed — try again",
    },
  },

  // GitHub module
  github: {
    title: "GitHub",
    openIssues: "Open issues",
    refresh: "Refresh",
    loading: "Updating…",
    // {time}: relative time, e.g. "5 min ago"
    updated: "Updated {time}",
    // {time}: clock time, e.g. 14:05
    rateLimited: "Rate limited until {time}",
    empty: "No repositories yet",
    addInSettings: "Add one in settings",
    newIssue: "New",
    noIssues: "No open issues",
    showBubble: {
      label: "Side bubble",
      desc: "Shows the total of open issues next to the island.",
    },
    peekOnNew: {
      label: "Expand on new issue",
      desc: "Opens the island for a few seconds when someone opens an issue.",
    },
    error: {
      notFound: "Not found or no access",
      unauthorized: "Token rejected by GitHub",
      rateLimited: "Rate limited",
      network: "Offline",
      http: "GitHub error",
    },
    repos: {
      title: "Repositories",
      desc: "Type owner/repo or paste a GitHub link. Counts refresh every 5 minutes.",
      placeholder: "owner/repo",
      add: "Add",
      remove: "Remove",
      invalid: "Use owner/repo or a github.com link.",
      duplicate: "Already added.",
    },
    account: {
      title: "GitHub account",
      // {login}: GitHub username
      token: "Signed in as {login} with a token.",
      gh: "Using the GitHub CLI login ({login}).",
      none: "Not signed in: public repositories only, with a lower rate limit. A GitHub CLI login is picked up automatically.",
      rejected: "The saved token was rejected by GitHub.",
      placeholder: "Personal access token",
      save: "Save",
      remove: "Remove token",
      stored: "Kept in the Windows Credential Manager, never in the settings file.",
      create: "Create a token",
    },
  },

  // Relative time
  time: {
    now: "now",
    minutesAgo: "{n} min ago",
    hoursAgo: "{n} h ago",
    daysAgo: "{n} d ago",
    lessThanMinute: "< 1 min",
  },

  // Claude Code agent
  claude: {
    limitsHint: {
      loading: "Loading plan limits…",
    },
    setup: {
      message: "Live status and plan limits via Claude Code hooks (settings.json is backed up first).",
      serverDown: "Local server unavailable (is port 47823 in use?).",
      action: "Enable integration",
    },
    integration: {
      title: "Claude Code integration",
      // {file}: path of Claude Code's settings file
      desc: "HTTP hooks for live status + statusline for plan limits. Your current statusline keeps working. A backup of {file} is created on every change.",
      enable: "Enable",
      remove: "Remove",
      server: "Local server :47823",
      restart: "Claude Code sessions that are already open must be restarted to load the hooks.",
    },
  },

  // What a Claude session is doing. Kinds come from
  // src-tauri/src/providers/claude/activity.rs; {arg} is a file name,
  // command, search pattern…
  activity: {
    thinking: "Thinking…",
    run: "Running {arg}",
    read: "Reading {arg}",
    edit: "Editing {arg}",
    write: "Writing {arg}",
    grep: "Searching “{arg}”",
    glob: "Looking for {arg}",
    webSearch: "Searching the web for “{arg}”",
    webFetch: "Reading {arg}",
    subagent: "Subagent: {arg}",
    todos: "Updating tasks",
    skill: "Skill {arg}",
    question: "Waiting for your answer",
    plan: "Plan ready",
    tool: "{arg}",
    message: "{arg}",
    done: "Done",
    failed: "Failed",
    interrupted: "Interrupted",
    // {what}: one of the activities above
    permission: "Permission: {what}",
  },
}
