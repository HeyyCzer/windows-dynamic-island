      add: "Add",
      remove: "Remove",
      invalid: "Use owner/repo or a github.com link.",
      duplicate: "Already added.",
    },
    account: {
      title: "GitHub account",
      // {login}: GitHub username
      token: "Signed in as {login} with a token.",
      gh: "Using the GitHub CLI login ({login}).",
      none: "Not signed in: public repositories only, with a lower rate limit. A GitHub CLI login is picked up automatically.",
      rejected: "The saved token was rejected by GitHub.",
      placeholder: "Personal access token",
      save: "Save",
      remove: "Remove token",
      stored: "Kept in the Windows Credential Manager, never in the settings file.",
      create: "Create a token",
