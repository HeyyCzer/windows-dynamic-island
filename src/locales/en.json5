  // Relative time
  time: {
    now: "now",
    minutesAgo: "{n} min ago",
    hoursAgo: "{n} h ago",
    daysAgo: "{n} d ago",
    lessThanMinute: "< 1 min",
  },

  // Claude Code agent
  claude: {
    limitsHint: {
      loading: "Loading plan limits…",
    },
    setup: {
      message: "Live status and plan limits via Claude Code hooks (settings.json is backed up first).",
      serverDown: "Local server unavailable (is port 47823 in use?).",
      action: "Enable integration",
    },
    integration: {
      title: "Claude Code integration",
      // {file}: path of Claude Code's settings file
      desc: "HTTP hooks for live status + statusline for plan limits. Your current statusline keeps working. A backup of {file} is created on every change.",
      enable: "Enable",
      remove: "Remove",
      server: "Local server :47823",
      restart: "Claude Code sessions that are already open must be restarted to load the hooks.",
    },
  },

  // What a Claude session is doing. Kinds come from
  // src-tauri/src/providers/claude/activity.rs; {arg} is a file name,
  // command, search pattern…
  activity: {
    thinking: "Thinking…",
    run: "Running {arg}",
    read: "Reading {arg}",
    edit: "Editing {arg}",
    write: "Writing {arg}",
    grep: "Searching “{arg}”",
    glob: "Looking for {arg}",
    webSearch: "Searching the web for “{arg}”",
    webFetch: "Reading {arg}",
    subagent: "Subagent: {arg}",
    todos: "Updating tasks",
    skill: "Skill {arg}",
    question: "Waiting for your answer",
    plan: "Plan ready",
    tool: "{arg}",
    message: "{arg}",
    done: "Done",
    failed: "Failed",
    interrupted: "Interrupted",
    // {what}: one of the activities above
    permission: "Permission: {what}",
  },
